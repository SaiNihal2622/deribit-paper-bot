# Deribit (public market data — no auth required for paper)
DERIBIT_ENV=testnet
DERIBIT_CURRENCIES=BTC,ETH
DERIBIT_POLL_SEC=2.0

# For live trading (REQUIRED for `python -m crypto_options_bot live`):
# 1. Create an API key at https://test.deribit.com (testnet) or
#    https://www.deribit.com (prod). Note: live requires the safety guard.
# 2. Grant the key the `trade:read_write` scope.
# 3. Set the env vars below and confirm the safety guard.
# DERIBIT_CLIENT_ID=your_api_key_here
# DERIBIT_CLIENT_SECRET=your_api_secret_here
# DERIBIT_LIVE_CONFIRMED=YES

# Optional: Telegram alerts (auto-enabled if BOTH are set)
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_CHAT_ID=987654321
