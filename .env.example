# Deribit (public market data — no auth required for paper)
DERIBIT_ENV=testnet
DERIBIT_CURRENCIES=BTC,ETH
DERIBIT_POLL_SEC=2.0

# For live trading (REQUIRED for `python -m crypto_options_bot live`):
# 1. Create an API key at https://test.deribit.com (testnet) or
#    https://www.deribit.com (prod). Note: live requires the safety guard.
# 2. Grant the key the `trade:read_write` scope.
# 3. Set the env vars below and confirm the safety guard.
# DERIBIT_CLIENT_ID=your_api_key_here
# DERIBIT_CLIENT_SECRET=your_api_secret_here
# DERIBIT_LIVE_CONFIRMED=YES

# Optional: Telegram alerts (auto-enabled if BOTH are set)
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_CHAT_ID=987654321

# ---------------------------------------------------------------------------
# 6-agent self-evolving system (python -m crypto_options_bot operator)
# ---------------------------------------------------------------------------
# The agent layer (Sentinel / Healer / Trader / Evolver / Reflector) uses
# an LLM to make discretionary decisions. Required for live use of the
# agent layer. Without it, the bot still runs and the agents fall back
# to rule-based decisions.
#
# The agent layer talks to the MiniMax Anthropic-compatible API at
# https://agent.minimax.io/mavis/api/v1/llm/v1 with authMode=managed-login
# when running inside a Mavis session. For 24/7 detached operation you
# must set MINIMAX_API_KEY explicitly.
# MINIMAX_API_KEY=sk-your-key-here
# MINIMAX_BASE_URL=https://agent.minimax.io/mavis/api/v1/llm/v1  # optional override
# MINIMAX_CONFIG=C:/Users/saini/.minimax/config.yaml                 # optional override
